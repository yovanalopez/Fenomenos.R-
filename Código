### Prueba de hipótesis sobre la diferencia de medias
 
## ----t2-----------------------------------------------------------------------------------------------------
n1 <- length(g1); n2 <- length(g2); d_obs <- mean(g1) - mean(g2)
if (iguales) {
  sp  <- sqrt(((n1 - 1) * var(g1) + (n2 - 1) * var(g2)) / (n1 + n2 - 2))
  ee  <- sp * sqrt(1 / n1 + 1 / n2); gl2 <- n1 + n2 - 2
} else {
  ee  <- sqrt(var(g1) / n1 + var(g2) / n2)
  gl2 <- ee^4 / ((var(g1) / n1)^2 / (n1 - 1) + (var(g2) / n2)^2 / (n2 - 1))
}
t_calc <- d_obs / ee
t_crit <- qt(1 - alpha / 2, gl2)
p_t    <- 2 * pt(-abs(t_calc), gl2)
ic_d   <- d_obs + c(-1, 1) * t_crit * ee
c(diferencia = d_obs, error_est = ee, gl = gl2, t = t_calc, critico = t_crit, p = p_t)
t.test(g1, g2, var.equal = iguales)   # verificación

 
# - Estadístico: $T_c = \dfrac{\bar x_C - \bar x_M}{EE} =$ **`r f(t_calc, 2)`** con $gl =$ `r f(gl2, 1)`.
# - Valor crítico: $\pm t_{`r f(gl2, 1)`;\,0.975} = \pm$ **`r f(t_crit)`**. Valor-$p$ = `r pf(p_t)`.
# - IC del 95% para $\mu_C - \mu_M$: (`r f(ic_d[1], 2)`, `r f(ic_d[2], 2)`) °C.
#- **Decisión:** como $|T_c|$ `r ifelse(abs(t_calc) > t_crit, "es mayor", "no es mayor")` que el valor crítico, `r dec(p_t)`.
# - **Conclusión:** `r ifelse(p_t < alpha, paste0("con un nivel de significancia del 5% hay evidencia de que la temperatura media difiere entre zonas: los eventos en zona ", ifelse(d_obs > 0, "costera", "montañosa"), " son en promedio ", f(abs(d_obs), 1), " °C más cálidos que en la otra zona. El intervalo de confianza no contiene el cero, lo que respalda la diferencia."), "con un nivel de significancia del 5% no hay evidencia de diferencia en la temperatura media entre zonas; el intervalo de confianza contiene el cero.")`
# - **Implicación para la operación:** `r ifelse(p_t < alpha, "las condiciones de operación, almacenamiento y transporte (por ejemplo, productos sensibles a la temperatura) deben diferenciarse entre zona costera y zona montañosa.", "no hace falta diferenciar las condiciones térmicas de operación entre estas dos zonas.")`
 
