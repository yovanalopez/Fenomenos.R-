# **Hipótesis:**

# $$H_0: \mu \le 2.5 \qquad \text{vs} \qquad H_1: \mu > 2.5$$

## ----media1-------------------------------------------------------------------------------------------------
r1 <- ph_media(datos$Duracion_horas, mu0 = 2.5, alt = "greater")
unlist(r1[c("n", "xb", "s", "est", "crit", "p")])
