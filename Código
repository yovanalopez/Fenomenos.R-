## Pregunta 5. Pruebas de normalidad
 
# Para cada variable cuantitativa se plantea:
 
# $$H_0: \text{la variable sigue una distribución normal} \qquad \text{vs} \qquad H_1: \text{la variable no sigue una distribución normal}$$
# 
# **Criterio de decisión:** se rechaza $H_0$ si valor-$p < \alpha = 0.05$. En las pruebas de normalidad se desea **no** rechazar $H_0$.
 
# **Pruebas utilizadas.** Como la base es grande ($n =$ `r n`), la prueba principal es **Anderson-Darling** (`nortest::ad.test`). Shapiro-Wilk se recomienda para muestras pequeñas (unos 60 datos o menos), por lo que aquí solo se usa como apoyo, junto con **Jarque-Bera** (`tseries::jarque.bera.test`, que usa la asimetría y la curtosis) y **Lilliefors** (Kolmogorov-Smirnov corregida). La verificación gráfica se hace con el **gráfico cuantil-cuantil (Q-Q)**: si los puntos siguen la recta y se mantienen dentro de las bandas de confianza, hay normalidad.
 
## ----normalidad---------------------------------------------------------------------------------------------
library(tseries)   # Jarque-Bera

prueba_norm <- function(v) {
  x  <- datos[[v]]
  ad <- ad.test(x); jb <- jarque.bera.test(x); li <- lillie.test(x); sw <- shapiro.test(x)
  data.frame(Variable = v, Prueba = "Anderson-Darling",
             Estadistico = unname(ad$statistic), Valor_p = ad$p.value,
             p_JarqueBera = jb$p.value, p_Lilliefors = li$p.value, p_Shapiro = sw$p.value,
             Asimetria = skewness(x, type = 3), Curtosis_exceso = kurtosis(x, type = 3))
}
norm_tab <- do.call(rbind, lapply(cuant, prueba_norm))
norm_tab$Conclusion <- ifelse(norm_tab$Valor_p < alpha, "No normal", "Compatible con normal")

# ¿alguna prueba de apoyo llega a una decisión distinta a Anderson-Darling?
apoyo_rech <- norm_tab[, c("p_JarqueBera", "p_Lilliefors", "p_Shapiro")] < alpha
norm_tab$Otras_discrepan <- (norm_tab$Valor_p >= alpha & rowSums(apoyo_rech) > 0) |
                            (norm_tab$Valor_p <  alpha & rowSums(!apoyo_rech) > 0)

tp <- data.frame(Variable = norm_tab$Variable, Prueba = norm_tab$Prueba,
                 Estadistico_A = round(norm_tab$Estadistico, 3),
                 Valor_p = sapply(norm_tab$Valor_p, pf), Conclusion = norm_tab$Conclusion)
kable(tp, row.names = FALSE, caption = "Prueba de normalidad principal (Anderson-Darling, α = 0.05)")

