## Pregunta 3. Pruebas de hipótesis sobre la media poblacional

# Como la desviación estándar poblacional es desconocida, se usa el estadístico $T = \dfrac{\bar X - \mu_0}{S/\sqrt{n}} \sim t_{n-1}$ (con $n$ grande la $t$ se aproxima a la normal). Como se hizo en clase, la afirmación que se quiere probar se plantea como hipótesis alterna $H_1$, y la hipótesis nula $H_0$ es su complemento (el estadístico se calcula en el valor frontera $\mu_0$). Se definen las funciones que calculan todos los pasos y se verifican con `t.test()`.
 
## ----fun-media----------------------------------------------------------------------------------------------
ph_media <- function(x, mu0, alt = c("two.sided", "greater", "less"), alpha = 0.05) {
  alt <- match.arg(alt)
  n <- length(x); xb <- mean(x); s <- sd(x); gl <- n - 1
  est <- (xb - mu0) / (s / sqrt(n))
  crit <- switch(alt, two.sided = qt(1 - alpha / 2, gl), greater = qt(1 - alpha, gl), less = qt(alpha, gl))
  p <- switch(alt, two.sided = 2 * pt(-abs(est), gl), greater = pt(est, gl, lower.tail = FALSE), less = pt(est, gl))
  rech <- switch(alt, two.sided = abs(est) > crit, greater = est > crit, less = est < crit)
  ic <- xb + c(-1, 1) * qt(1 - alpha / 2, gl) * s / sqrt(n)
  list(n = n, xb = xb, s = s, gl = gl, est = est, crit = crit, p = p, rech = rech, ic = ic)
}


