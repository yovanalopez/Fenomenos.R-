## Pregunta 4. Pruebas de hipótesis sobre proporciones
 
# Estadístico: $Z = \dfrac{\hat P - \pi_0}{\sqrt{\pi_0(1-\pi_0)/n}} \approx N(0,1)$, válido si $n\pi_0 \ge 10$ y $n(1-\pi_0) \ge 10$.
 
## ----fun-prop-----------------------------------------------------------------------------------------------
ph_prop <- function(x, n, p0, alt = c("two.sided", "greater", "less"), alpha = 0.05) {
  alt <- match.arg(alt)
  ph <- x / n
  est <- (ph - p0) / sqrt(p0 * (1 - p0) / n)
  crit <- switch(alt, two.sided = qnorm(1 - alpha / 2), greater = qnorm(1 - alpha), less = qnorm(alpha))
  p <- switch(alt, two.sided = 2 * pnorm(-abs(est)), greater = pnorm(est, lower.tail = FALSE), less = pnorm(est))
  rech <- switch(alt, two.sided = abs(est) > crit, greater = est > crit, less = est < crit)
  list(x = x, n = n, ph = ph, est = est, crit = crit, p = p, rech = rech,
       cond = c(n * p0, n * (1 - p0)))
}


