## Pregunta 8. Comparación de proporciones entre dos grupos
 
# Estadístico bajo $H_0: \pi_1 = \pi_2$ (proporción combinada $\hat p = \frac{x_1 + x_2}{n_1 + n_2}$):
 
# $$Z = \frac{\hat P_1 - \hat P_2}{\sqrt{\hat p(1-\hat p)\left(\frac{1}{n_1} + \frac{1}{n_2}\right)}}$$
 
## ----fun-prop2----------------------------------------------------------------------------------------------
ph_prop2 <- function(x1, n1, x2, n2, alt = c("two.sided", "greater", "less"), alpha = 0.05) {
  alt <- match.arg(alt)
  p1 <- x1 / n1; p2 <- x2 / n2; pc <- (x1 + x2) / (n1 + n2)
  est <- (p1 - p2) / sqrt(pc * (1 - pc) * (1 / n1 + 1 / n2))
  crit <- switch(alt, two.sided = qnorm(1 - alpha / 2), greater = qnorm(1 - alpha), less = qnorm(alpha))
  p <- switch(alt, two.sided = 2 * pnorm(-abs(est)), greater = pnorm(est, lower.tail = FALSE), less = pnorm(est))
  rech <- switch(alt, two.sided = abs(est) > crit, greater = est > crit, less = est < crit)
  ee_nc <- sqrt(p1 * (1 - p1) / n1 + p2 * (1 - p2) / n2)
  ic <- (p1 - p2) + c(-1, 1) * qnorm(1 - alpha / 2) * ee_nc
  list(x1 = x1, n1 = n1, x2 = x2, n2 = n2, p1 = p1, p2 = p2, pc = pc, est = est, crit = crit, p = p, rech = rech, ic = ic,
       cond = c(n1 * pc, n1 * (1 - pc), n2 * pc, n2 * (1 - pc)))
}

