## ----prop-8-2-----------------------------------------------------------------
x1 <- x_zona["Costera"]; n1 <- n_zona["Costera"]
x2 <- x_zona["Urbana"];  n2 <- n_zona["Urbana"]
pr2 <- prop.test(c(x1, x2), c(n1, n2), correct = FALSE)
pr2
pc <- (x1 + x2) / (n1 + n2)
z82 <- unname((x1 / n1 - x2 / n2) / sqrt(pc * (1 - pc) * (1 / n1 + 1 / n2)))
c(Z = z82, Z_critico = qnorm(1 - alpha / 2))

