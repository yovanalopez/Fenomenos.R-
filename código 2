knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE, fig.align = "center")
options(digits = 5)

# 
# # Introducción
# 
# Los fenómenos atmosféricos, como lo son en este caso las tormentas eléctricas, las lluvias intensas, los vendavales y las granizadas, afectan con frecuencia las operaciones industriales, logísticas y de distribución en Colombia. Cuando ocurren, pueden llegar a interrumpir el transporte, retrasar el abastecimiento y obligar a las empresas a replantear su planificación. Es por ello que desde la Ingeniería Industrial es importante entender cómo se comportan estos fenómenos y qué tan graves pueden llegar a ser para las comunidades en general.
# 
# En el presente trabajo se analiza una base de datos con 450 eventos atmosféricos registrados, en la que se anotan el tipo de fenómeno, su intensidad, la zona de ocurrencia, el nivel de afectación, la precipitación, la velocidad del viento, la duración, la temperatura y el número de municipios afectados. En el trabajo primero se hace un análisis descriptivo para conocer los datos, y luego se aplican pruebas de hipótesis sobre medias y proporciones, pruebas de normalidad, la aplicación de una prueba Chi-cuadrado de independencia y las comparaciones entre los grupos. El objetivo de todo ello es identificar aquellos patrones que sirvan de apoyo en la gestión del riesgo y en la toma de decisiones.
# 
# En todo el trabajo se usa un nivel de significancia $\alpha = 0.05$. Se rechaza $H_0$ cuando el valor-$p < \alpha$ (o cuando el estadístico cae en la región de rechazo).
# 
## ----paquetes-----------------------------------------------------------------
library(readxl)      # leer Excel
library(RcmdrMisc)   # numSummary
library(car)         # qqPlot
library(nortest)     # ad.test (Anderson-Darling)
library(tseries)     # jarque.bera.test

alpha <- 0.05
pval <- function(p) ifelse(p < 0.0001, "< 0.0001", round(p, 4))   # para escribir valores-p

# 
# # Pregunta 1. Carga de la base y clasificación de variables
# 
# La base se genera con el script de la profesora (`FENOMENOS_ATMOSFERICOS.R`), en el que solo se modificó el valor de `n` (450 eventos). Luego se lee el Excel que genera.
# 
## ----carga--------------------------------------------------------------------
source("FENOMENOS_ATMOSFERICOS.R")   # genera Base_Fenomenos_Atmosfericos_Colombia.xlsx

datos <- as.data.frame(read_excel("Base_Fenomenos_Atmosfericos_Colombia.xlsx"))
datos$Zona_Ocurrencia  <- factor(datos$Zona_Ocurrencia, levels = c("Urbana", "Rural", "Costera", "Montañosa"))
datos$Nivel_Intensidad <- factor(datos$Nivel_Intensidad, levels = c("Baja", "Moderada", "Alta", "Extrema"), ordered = TRUE)
datos$Nivel_Afectacion <- factor(datos$Nivel_Afectacion, levels = c("Bajo", "Medio", "Alto"), ordered = TRUE)
datos$Tipo_Fenomeno    <- factor(datos$Tipo_Fenomeno)

n <- nrow(datos)
cuant <- c("Precipitacion_mm", "Velocidad_Viento_kmh", "Duracion_horas", "Temperatura_C", "Municipios_Afectados")
head(datos)
str(datos)
sum(is.na(datos))   # valores faltantes

# 
# La base tiene `r n` eventos y `r ncol(datos)` variables, sin valores faltantes.
# 
# | Variable | Naturaleza | Tipo |
# |---|---|---|
# | Tipo_Fenomeno | Cualitativa | Nominal |
# | Zona_Ocurrencia | Cualitativa | Nominal |
# | Nivel_Intensidad | Cualitativa | Ordinal (Baja < Moderada < Alta < Extrema) |
# | Nivel_Afectacion | Cualitativa | Ordinal (Bajo < Medio < Alto) |
# | Precipitacion_mm | Cuantitativa | Continua |
# | Velocidad_Viento_kmh | Cuantitativa | Continua |
# | Duracion_horas | Cuantitativa | Continua |
# | Temperatura_C | Cuantitativa | Continua |
# | Municipios_Afectados | Cuantitativa | Discreta |
# 
# # Pregunta 2. Análisis descriptivo
# 
## ----descriptiva--------------------------------------------------------------
numSummary(datos[cuant], statistics = c("mean", "sd", "IQR", "quantiles", "skewness"),
           quantiles = c(0, 0.25, 0.5, 0.75, 1), type = "3")

round(sapply(datos[cuant], var), 2)                                         # varianza
round(100 * sapply(datos[cuant], sd) / sapply(datos[cuant], mean), 1)       # coeficiente de variación (%)
round(cor(datos[cuant]), 2)                                                 # correlaciones
round(100 * prop.table(table(datos$Tipo_Fenomeno)), 1)                      # % por tipo de fenómeno
round(100 * prop.table(table(datos$Nivel_Afectacion)), 1)                   # % por nivel de afectación

# 
## ----graf-desc, fig.height=6.5------------------------------------------------
par(mfrow = c(2, 3))
for (v in cuant) hist(datos[[v]], main = v, xlab = v, ylab = "Frecuencia", col = "steelblue", border = "white")
par(mfrow = c(2, 3))
for (v in cuant) boxplot(datos[[v]], horizontal = TRUE, main = v, xlab = v, col = "lightgreen")

# 
## ----graf-grupos, fig.height=4.5----------------------------------------------
par(mfrow = c(1, 3))
boxplot(Temperatura_C ~ Zona_Ocurrencia, data = datos, col = "lightblue", cex.axis = 0.75,
        main = "Temperatura por zona", xlab = "Zona", ylab = "°C")
boxplot(Municipios_Afectados ~ Nivel_Afectacion, data = datos, col = "orange",
        main = "Municipios afectados\nsegún afectación", xlab = "Nivel de afectación", ylab = "Municipios")
plot(datos$Precipitacion_mm, datos$Duracion_horas, pch = 20, col = as.integer(datos$Nivel_Intensidad) + 1,
     main = "Duración vs precipitación", xlab = "Precipitación (mm)", ylab = "Horas")
legend("topleft", legend = levels(datos$Nivel_Intensidad), col = 2:5, pch = 20, cex = 0.7)

# 
# **Patrones.**
# 
# - Las cinco variables son aproximadamente simétricas (media cercana a la mediana y asimetría cercana a 0). Hay pocos datos atípicos.
# - La variabilidad relativa va de baja en la temperatura (CV ≈ 14%) a alta en los municipios afectados (CV ≈ 40%).
# - Precipitación y duración están fuertemente relacionadas (r = `r round(cor(datos$Precipitacion_mm, datos$Duracion_horas), 2)`): a más lluvia, el evento dura más. Los eventos con afectación alta alcanzan más municipios.
# - La temperatura es mayor en zona costera (`r round(mean(datos$Temperatura_C[datos$Zona_Ocurrencia == "Costera"]), 1)` °C) y menor en zona montañosa (`r round(mean(datos$Temperatura_C[datos$Zona_Ocurrencia == "Montañosa"]), 1)` °C).
# - La lluvia intensa y la tormenta eléctrica son los fenómenos más frecuentes, y la mayoría de los eventos tiene afectación media.
# 
# # Pregunta 3. Pruebas de hipótesis para la media
# 
# La afirmación que se quiere probar se plantea como $H_1$. Como $\sigma$ es desconocida se usa `t.test`.
# 
# ## 3.1 ¿La duración promedio de los eventos es mayor a 2.5 horas?
# 
# $$H_0: \mu \le 2.5 \qquad \text{vs} \qquad H_1: \mu > 2.5$$
# 
## ----media1-------------------------------------------------------------------
t1 <- t.test(datos$Duracion_horas, mu = 2.5, alternative = "greater")
t1
qt(1 - alpha, df = n - 1)   # valor crítico

# 
# El estadístico es $t =$ `r round(t1$statistic, 2)` y el valor crítico es `r round(qt(1 - alpha, n - 1), 3)`. Como $t$ es mayor que el valor crítico (valor-$p$ `r pval(t1$p.value)`), **se rechaza $H_0$**: hay evidencia de que la duración promedio es mayor a 2.5 horas (media muestral `r round(t1$estimate, 2)` h).
# *Implicación:* los turnos, rutas y despachos deben programarse con holguras de más de 2.5 horas de interrupción.
# 
# ## 3.2 ¿La temperatura promedio de los eventos es diferente de 21 °C?
# 
# $$H_0: \mu = 21 \qquad \text{vs} \qquad H_1: \mu \ne 21$$
# 
## ----media2-------------------------------------------------------------------
t2 <- t.test(datos$Temperatura_C, mu = 21)
t2
qt(1 - alpha / 2, df = n - 1)   # valor crítico (±)

# 
# El estadístico es $t =$ `r round(t2$statistic, 2)` y el valor crítico es $\pm$ `r round(qt(1 - alpha / 2, n - 1), 3)`. Como $|t|$ es menor que el valor crítico (valor-$p$ `r pval(t2$p.value)`), **no se rechaza $H_0$**: no hay evidencia de que la temperatura promedio sea distinta de 21 °C (el IC al 95% es (`r round(t2$conf.int[1], 2)`, `r round(t2$conf.int[2], 2)`)).
# *Implicación:* no se requieren ajustes especiales por temperatura en la planificación general.
# 
# # Pregunta 4. Pruebas de hipótesis para proporciones
# 
# Estadístico: $Z = \dfrac{\hat p - \pi_0}{\sqrt{\pi_0(1-\pi_0)/n}}$ (se cumple $n\pi_0 \ge 10$ y $n(1-\pi_0) \ge 10$ en ambos casos).
# 
# ## 4.1 ¿La proporción de granizadas es menor al 20%?
# 
# $$H_0: \pi \ge 0.20 \qquad \text{vs} \qquad H_1: \pi < 0.20$$
# 
## ----prop1--------------------------------------------------------------------
x_g <- sum(datos$Tipo_Fenomeno == "Granizada")
p1 <- prop.test(x_g, n, p = 0.20, alternative = "less", correct = FALSE)
p1
z1 <- (x_g / n - 0.20) / sqrt(0.20 * 0.80 / n)   # estadístico Z
c(p_gorro = x_g / n, Z = z1, Z_critico = qnorm(alpha))

# 
# Hubo `r x_g` granizadas en `r n` eventos ($\hat p =$ `r round(x_g / n, 4)`). Como $Z =$ `r round(z1, 2)` es menor que el valor crítico `r round(qnorm(alpha), 3)` (valor-$p$ `r pval(p1$p.value)`), **se rechaza $H_0$**: hay evidencia de que las granizadas son menos del 20% de los eventos.
# *Implicación:* son un riesgo menos frecuente; los recursos de contingencia pueden priorizarse en los fenómenos más recurrentes, sin descuidar la protección de vehículos y producto.
# 
# ## 4.2 ¿La proporción de eventos con afectación alta es diferente de 25%?
# 
# $$H_0: \pi = 0.25 \qquad \text{vs} \qquad H_1: \pi \ne 0.25$$
# 
## ----prop2--------------------------------------------------------------------
x_a <- sum(datos$Nivel_Afectacion == "Alto")
p2 <- prop.test(x_a, n, p = 0.25, correct = FALSE)
p2
z2 <- (x_a / n - 0.25) / sqrt(0.25 * 0.75 / n)
c(p_gorro = x_a / n, Z = z2, Z_critico = qnorm(1 - alpha / 2))

# 
# Hubo `r x_a` eventos de afectación alta ($\hat p =$ `r round(x_a / n, 4)`). Como $|Z| =$ `r round(abs(z2), 2)` es menor que 1.96 (valor-$p$ `r pval(p2$p.value)`), **no se rechaza $H_0$**: es compatible con que uno de cada cuatro eventos tenga afectación alta.
# *Implicación:* ese 25% es una referencia razonable para dimensionar los recursos de emergencia.
# 
# # Pregunta 5. Pruebas de normalidad
# 
# Para cada variable cuantitativa:
# 
# $$H_0: \text{la variable sigue una distribución normal} \qquad \text{vs} \qquad H_1: \text{la variable no sigue una distribución normal}$$
# 
# Como la base es grande (450 datos), la prueba principal es **Anderson-Darling** (`ad.test`). Como apoyo se usan **Shapiro-Wilk** (`shapiro.test`) y **Lilliefors** (`lillie.test`), y además se revisan los histogramas con la curva normal teórica (en rojo) y los gráficos **cuantil-cuantil**. Se rechaza $H_0$ si el valor-$p < 0.05$ en Anderson-Darling.
# 
## ----normalidad---------------------------------------------------------------
norm_tab <- data.frame(
  Variable     = cuant,
  A_Darling    = sapply(cuant, function(v) ad.test(datos[[v]])$statistic),
  p_Darling    = sapply(cuant, function(v) ad.test(datos[[v]])$p.value),
  p_Shapiro    = sapply(cuant, function(v) shapiro.test(datos[[v]])$p.value),
  p_Lilliefors = sapply(cuant, function(v) lillie.test(datos[[v]])$p.value))
norm_tab$Decision <- ifelse(norm_tab$p_Darling < alpha, "No normal", "Normal (no se rechaza H0)")
knitr::kable(norm_tab, digits = 4, row.names = FALSE)

# 
## ----normalidad-graf, fig.height=7--------------------------------------------
par(mfrow = c(2, 3))   # histogramas con la curva normal teórica (en rojo)
for (v in cuant) {
  hist(datos[[v]], freq = FALSE, breaks = 20, col = "lightblue", border = "white",
       main = v, xlab = v, ylab = "Densidad")
  curve(dnorm(x, mean(datos[[v]]), sd(datos[[v]])), add = TRUE, col = "red", lwd = 2)
}
par(mfrow = c(2, 3))   # gráficos cuantil-cuantil
for (v in cuant) qqPlot(datos[[v]], distribution = "norm", main = v, id = FALSE,
                        xlab = "Cuantiles teóricos", ylab = "Cuantiles muestrales")

# 
# **Interpretación.** Según Anderson-Darling, la precipitación (valor-$p$ = 0.0935), la duración (0.4465) y la temperatura (0.1722) tienen un valor-$p$ mayor que 0.05, así que no se rechaza $H_0$: no hay evidencia de que se alejen de la normal. En los histogramas se nota, porque las barras siguen bastante bien la curva roja, y en los gráficos Q-Q los puntos quedan pegados a la recta. La precipitación es un caso límite, porque Lilliefors sí la rechaza (valor-$p$ = 0.0276) aunque Shapiro-Wilk y Anderson-Darling no. En su histograma se ve una barra alta cerca de 90 mm que sobresale de la curva, pero en general tiene forma de campana.
# 
# En cambio, la velocidad del viento (valor-$p$ = 0.0032) y los municipios afectados (valor-$p$ < 0.0001) sí se rechazan: **no siguen una distribución normal**. En el Q-Q del viento los puntos de los extremos se salen de las bandas, y su histograma se ve más aplanado que la curva roja. En los municipios afectados los puntos forman escalones, porque es una variable de conteo (números enteros), y en el histograma se observa una segunda "joroba" entre 18 y 21 municipios que la curva normal no alcanza a seguir.
# 
# Esto no impide hacer pruebas sobre medias, porque con 450 datos el teorema del límite central hace que la media muestral sea aproximadamente normal. Eso sí, para la gestión del riesgo no conviene usar la curva normal para calcular la probabilidad de eventos extremos de viento o de muchos municipios afectados.
# 
# # Pregunta 6. Prueba Chi-cuadrado de independencia
# 
# **Pregunta de investigación:** ¿existe asociación entre la zona de ocurrencia del fenómeno y el nivel de afectación que produce? Con esto se quiere saber si hay zonas del país (urbana, rural, costera o montañosa) donde los eventos causan más daño, para priorizar los recursos por territorio.
# 
# $$H_0: \text{la zona de ocurrencia y el nivel de afectación son independientes} \qquad \text{vs} \qquad H_1: \text{existe asociación entre ambas}$$
# 
## ----chi----------------------------------------------------------------------
tabla_zona <- table(datos$Zona_Ocurrencia, datos$Nivel_Afectacion)
tabla_zona
round(100 * prop.table(tabla_zona, 1), 1)     # % por fila

chi <- chisq.test(tabla_zona)
chi$expected                                  # valores esperados
min(chi$expected)                             # supuesto: todos >= 5
sum((tabla_zona - chi$expected)^2 / chi$expected)   # estadístico calculado a mano
chi
qchisq(1 - alpha, df = chi$parameter)         # valor crítico
sqrt(chi$statistic / (n * min(dim(tabla_zona) - 1)))   # V de Cramér

# 
## ----chi-graf, fig.height=3.8-------------------------------------------------
library(ggplot2)
ggplot(as.data.frame(prop.table(tabla_zona, 1)), aes(Var1, Freq, fill = Var2)) +
  geom_col() + scale_y_continuous(labels = scales::percent) +
  labs(title = "Nivel de afectación según la zona", x = "Zona de ocurrencia",
       y = "Porcentaje dentro de la zona", fill = "Afectación") + theme_minimal()

# 
# **Supuestos.** Todas las frecuencias esperadas son mayores o iguales a 5 (la menor es 17.27), así que se puede aplicar la prueba. Además, cada fila de la base es un evento distinto, por lo que las observaciones son independientes.
# 
# **Resultado.** El estadístico es $\chi^2 = 9.67$ con $(4-1)(3-1) = 6$ grados de libertad, y el valor crítico es 12.59. Como $\chi^2$ es menor que el valor crítico (valor-$p$ = 0.1394), **no se rechaza $H_0$**: no hay evidencia de que el nivel de afectación dependa de la zona. La V de Cramér es 0.10, es decir, una asociación débil.
# 
# En el gráfico se observa que la zona costera tiene la mayor proporción de afectación alta (32.6%) y la urbana la menor (23.5%), pero las barras se ven parecidas entre zonas, y esas diferencias son lo bastante pequeñas como para explicarse por el azar.
# 
# *Implicación:* la zona por sí sola no es un buen criterio para decidir dónde concentrar los recursos de emergencia. Conviene planear según el tipo de fenómeno y su intensidad, y mantener un nivel de preparación similar en todas las zonas.
# 
# # Pregunta 7. Comparación de medias
# 
# **Pregunta de investigación:** ¿la precipitación acumulada promedio de la lluvia intensa es diferente a la de la tormenta eléctrica? Las dos traen lluvia, pero si una acumula más agua, el riesgo de inundación, de cierre de vías y de retrasos en el transporte también sería distinto.
# 
# $$H_0: \mu_{LI} = \mu_{TE} \qquad \text{vs} \qquad H_1: \mu_{LI} \ne \mu_{TE}$$
# 
# Donde $\mu_{LI}$ es la precipitación media de la lluvia intensa y $\mu_{TE}$ la de la tormenta eléctrica. Primero se verifica la igualdad de varianzas ($H_0: \sigma^2_{LI} = \sigma^2_{TE}$) con `var.test`.
# 
## ----medias-------------------------------------------------------------------
g1 <- datos$Precipitacion_mm[datos$Tipo_Fenomeno == "Lluvia intensa"]
g2 <- datos$Precipitacion_mm[datos$Tipo_Fenomeno == "Tormenta eléctrica"]
c(n1 = length(g1), n2 = length(g2), media1 = mean(g1), media2 = mean(g2), sd1 = sd(g1), sd2 = sd(g2))
c(p_norm_LI = ad.test(g1)$p.value, p_norm_TE = ad.test(g2)$p.value)   # normalidad de cada grupo

vt <- var.test(g1, g2)
vt
iguales <- vt$p.value > alpha

tt <- t.test(g1, g2, alternative = "two.sided", var.equal = iguales, paired = FALSE)
tt
qt(1 - alpha / 2, df = tt$parameter)   # valor crítico (±)

# 
## ----medias-graf, fig.height=3.5----------------------------------------------
dd <- data.frame(Prec = c(g1, g2), Tipo = rep(c("Lluvia intensa", "Tormenta eléctrica"), c(length(g1), length(g2))))
ggplot(dd, aes(Tipo, Prec, fill = Tipo)) + geom_boxplot(show.legend = FALSE) +
  stat_summary(fun = mean, geom = "point", shape = 18, size = 3, color = "red") +
  labs(title = "Precipitación acumulada por tipo de fenómeno", subtitle = "El rombo rojo marca la media de cada grupo",
       x = NULL, y = "Precipitación (mm)") + theme_minimal()

# 
# **Supuestos.** Los dos grupos son independientes y tienen más de 30 datos (147 lluvias intensas y 119 tormentas eléctricas), y la prueba de Anderson-Darling no rechaza la normalidad en ninguno (valor-$p$ de 0.1608 y 0.5637). Para la igualdad de varianzas, `var.test` da $F = 0.85$ y un valor-$p$ de 0.3505, así que no se rechaza que sean iguales y se usa la prueba $t$ con varianzas iguales.
# 
# **Resultado.** El estadístico es $t = 4.19$ con 264 grados de libertad, y el valor crítico es $\pm 1.969$. Como $|t|$ es mayor que el valor crítico (valor-$p$ < 0.0001), **se rechaza $H_0$**: la precipitación media es distinta entre los dos fenómenos. La lluvia intensa acumula en promedio 106.5 mm y la tormenta eléctrica 95.1 mm, y el intervalo de confianza al 95% de la diferencia es (6.02, 16.67) mm, que no contiene el cero.
# 
# En el boxplot se observa que la caja y la mediana de la lluvia intensa quedan más arriba que las de la tormenta eléctrica, y lo mismo pasa con los rombos rojos, que son las medias. Aun así, las cajas se traslapan un poco, así que la diferencia (de unos 11 mm en promedio) existe, pero no es enorme.
# 
# *Implicación:* ante una alerta de lluvia intensa conviene activar medidas más fuertes contra inundaciones: revisar drenajes, proteger el inventario en bodegas, buscar rutas alternas y prever más tiempo para las entregas.
# 
# # Pregunta 8. Comparación de proporciones
# 
## ----prop-2-------------------------------------------------------------------
alto <- datos$Nivel_Afectacion == "Alto"
x_tipo <- tapply(alto, datos$Tipo_Fenomeno, sum);   n_tipo <- table(datos$Tipo_Fenomeno)
x_zona <- tapply(alto, datos$Zona_Ocurrencia, sum); n_zona <- table(datos$Zona_Ocurrencia)
round(x_tipo / n_tipo, 3)    # proporción de afectación alta por tipo
round(x_zona / n_zona, 3)    # proporción de afectación alta por zona

# 
# Antes de las pruebas, la gráfica muestra la proporción de eventos con afectación alta según el tipo de fenómeno y según la zona. La línea roja marca la proporción general (26.7%).
# 
## ----prop-graf, fig.height=3.8------------------------------------------------
par_8 <- rbind(data.frame(Grupo = names(x_tipo), Prop = as.numeric(x_tipo / n_tipo), Variable = "Tipo de fenómeno"),
               data.frame(Grupo = names(x_zona), Prop = as.numeric(x_zona / n_zona), Variable = "Zona de ocurrencia"))
ggplot(par_8, aes(Grupo, Prop)) + geom_col(fill = "steelblue") +
  geom_hline(yintercept = mean(alto), color = "red", linetype = "dashed") +
  facet_wrap(~ Variable, scales = "free_x") + scale_y_continuous(labels = scales::percent) +
  labs(title = "Eventos con afectación alta", subtitle = "La línea roja marca la proporción general",
       x = NULL, y = "Proporción con afectación alta") + theme_minimal() +
  theme(axis.text.x = element_text(angle = 20, hjust = 1))

# 
# ## 8.1 ¿La proporción de afectación alta es mayor en lluvia intensa que en granizada?
# 
# $$H_0: \pi_{LL} \le \pi_{G} \qquad \text{vs} \qquad H_1: \pi_{LL} > \pi_{G}$$
# 
## ----prop-8-1-----------------------------------------------------------------
x1 <- x_tipo["Lluvia intensa"]; n1 <- n_tipo["Lluvia intensa"]
x2 <- x_tipo["Granizada"];      n2 <- n_tipo["Granizada"]
pr1 <- prop.test(c(x1, x2), c(n1, n2), alternative = "greater", correct = FALSE)
pr1
pc <- (x1 + x2) / (n1 + n2)
z81 <- unname((x1 / n1 - x2 / n2) / sqrt(pc * (1 - pc) * (1 / n1 + 1 / n2)))
c(Z = z81, Z_critico = qnorm(1 - alpha))

# 
# En la gráfica se observa que la granizada tiene una proporción de afectación alta mucho menor (6.8%) que la lluvia intensa (31.3%), que es la barra más alta entre los tipos de fenómeno. Como $Z = 4.05$ supera el valor crítico 1.645 (valor-$p$ < 0.0001), **se rechaza $H_0$**: la lluvia intensa genera afectación alta con mayor frecuencia que la granizada.
# 
# *Implicación:* ante lluvia intensa se justifica activar antes los protocolos de contingencia, como suspender rutas y reprogramar despachos. La tormenta eléctrica (30.3%) y el vendaval (29.7%) tienen proporciones parecidas a la de la lluvia intensa, así que también merecen atención.
